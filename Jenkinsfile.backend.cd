pipeline {
    agent any
    
    stages {
        stage('🚀 Deploy Backend to Kubernetes') {
            steps {
                script {
                    echo "Deploying Backend components to Kubernetes..."
                    checkout scm
                    withCredentials([file(credentialsId: 'k8s-config', variable: 'KUBECONFIG')]) {
                        sh "kubectl apply -f k8s/namespace.yaml"
                        sh "kubectl apply -f k8s/mongodb-k8s.yaml"
                        sh "kubectl apply -f k8s/backend-k8s.yaml"
                    }
                }
            }
        }
    }

    post {
        success {
            echo "✅ Backend Deployment Successful!"
            // Une fois le backend CD fini, on peut trigger le CI du frontend
            build job: 'buildmarket-frontend', wait: false, propagate: false
        }
    }
}
