// ============================================================
// BuildMarket — Jenkins CI Pipeline (FRONTEND)
// Handles: React (Vite 8) + Nginx + K8s Deployment
// ============================================================

pipeline {
    agent any

    environment {
        DOCKER_HUB_USER = "alabendawed871"
        DOCKER_CREDS    = credentials('docker-hub-credentials')
        SONAR_AUTH      = credentials('sonar-token')
    }

    options {
        timeout(time: 20, unit: 'MINUTES')
        buildDiscarder(logRotator(numToKeepStr: '10'))
        timestamps()
    }

    stages {
        stage('🚀 Preparation') {
            steps {
                echo "Fetching source code..."
                checkout scm
            }
        }

        stage('🧪 Unit Tests') {
            steps {
                dir('front') {
                    echo "Cleaning and Installing dependencies..."
                    sh "rm -rf node_modules package-lock.json"
                    sh "npm install"
                    sh "npm run test:coverage"
                }
            }
        }

        stage('🔍 SonarQube Analysis') {
            steps {
                script {
                    echo "Running SonarQube Scan for Frontend..."
                    sh "docker run --rm -v \"jenkins_home:/var/jenkins_home\" -w \"/var/jenkins_home/workspace/${env.JOB_NAME}\" --network buildmarket-net sonarsource/sonar-scanner-cli -Dsonar.projectKey=buildmarket-frontend -Dsonar.projectName=\"BuildMarket Frontend\" -Dsonar.host.url=http://buildmarket-sonar:9000 -Dsonar.token=\$SONAR_AUTH -Dsonar.sources=front/src -Dsonar.javascript.lcov.reportPaths=front/coverage/lcov.info"
                }
            }
        }

        stage('🎨 Build Frontend') {
            steps {
                script {
                    echo "🛠️ Building Frontend Image (React/Vite)..."
                    // Note: This uses the fixed Dockerfile with Debian-slim and Node 22
                    sh "docker build -t ${DOCKER_HUB_USER}/buildmarket-frontend:latest ./front"
                }
            }
        }

        stage('☁️ Push Image') {
            steps {
                script {
                    echo "🔐 Logging into DockerHub..."
                    sh "echo \$DOCKER_CREDS_PSW | docker login -u \$DOCKER_CREDS_USR --password-stdin"
                    
                    echo "📤 Pushing Frontend..."
                    sh "docker push ${DOCKER_HUB_USER}/buildmarket-frontend:latest"
                }
            }
            post {
                always {
                    sh "docker logout"
                }
            }
        }

        stage('🔗 Trigger CD Frontend') {
            steps {
                script {
                    echo "➡️ Triggering CD Pipeline: buildmarket-frontend-cd"
                    build job: 'buildmarket-frontend-cd', wait: false, propagate: false
                }
            }
        }
    }

    post {
        success {
            echo "✅ Frontend CI/CD Pipeline finished successfully!"
        }
        failure {
            echo "❌ Pipeline failed. Check logs for details."
        }
    }
}
