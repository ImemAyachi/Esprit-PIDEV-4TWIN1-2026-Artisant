// ============================================================
// BuildMarket — Jenkins CI Pipeline (FRONTEND)
// Handles: React (Vite 8) + Nginx + K8s Deployment
// ============================================================

pipeline {
    agent any

    environment {
        DOCKER_HUB_USER = "alabendawed871"
        DOCKER_CREDS    = credentials('docker-hub-credentials')
        SONAR_AUTH      = credentials('sonar-token')
    }

    options {
        timeout(time: 20, unit: 'MINUTES')
        buildDiscarder(logRotator(numToKeepStr: '10'))
        timestamps()
    }

    stages {
        stage('🚀 Preparation') {
            steps {
                echo "Fetching source code..."
                checkout scm
            }
        }

        stage('🔍 SonarQube Analysis') {
            steps {
                script {
                    echo "Running SonarQube Scan for Frontend..."
                    sh """
                    docker run --rm \
                        -v "\$(pwd):/usr/src" \
                        --network buildmarket-net \
                        sonarsource/sonar-scanner-cli \
                        -Dsonar.projectKey=buildmarket-frontend \
                        -Dsonar.host.url=http://buildmarket-sonar:9000 \
                        -Dsonar.token=\$SONAR_AUTH \
                        -Dsonar.sources=front/src
                    """
                }
            }
        }

        stage('🎨 Build Frontend') {
            steps {
                script {
                    echo "🛠️ Building Frontend Image (React/Vite)..."
                    // Note: This uses the fixed Dockerfile with Debian-slim and Node 22
                    sh "docker build -t ${DOCKER_HUB_USER}/buildmarket-frontend:latest ./front"
                }
            }
        }

        stage('☁️ Push Image') {
            steps {
                script {
                    echo "🔐 Logging into DockerHub..."
                    sh "echo \$DOCKER_CREDS_PSW | docker login -u \$DOCKER_CREDS_USR --password-stdin"
                    
                    echo "📤 Pushing Frontend..."
                    sh "docker push ${DOCKER_HUB_USER}/buildmarket-frontend:latest"
                }
            }
            post {
                always {
                    sh "docker logout"
                }
            }
        }
    }

    post {
        success {
            echo "✨ Frontend Pipeline & K8s Deployment completed!"
        }
        failure {
            echo "🚒 Build or Deployment failed."
        }
    }
}
