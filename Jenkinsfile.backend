// ============================================================
// BuildMarket — Jenkins CI Pipeline (BACKEND & GEOMETRY)
// Handles: Node.js Backend + Python Geometry Service
// ============================================================

pipeline {
    agent any
    
    environment {
        DOCKER_HUB_USER = "alabendawed871"
        // Credentials
        DOCKER_CREDS    = credentials('docker-hub-credentials') 
        SONAR_AUTH      = credentials('sonar-token')
    }

    options {
        timeout(time: 30, unit: 'MINUTES')
        buildDiscarder(logRotator(numToKeepStr: '10'))
        timestamps()
    }

    stages {
        stage('🚀 Preparation') {
            steps {
                echo "Checking environment..."
                sh "docker version"
                checkout scm
            }
        }

        stage('🧪 Tests & Coverage') {
            steps {
                script {
                    echo "Running Unit Tests..."
                    // On utilise une astuce : on cherche le dossier physique sur le volume pour le monter proprement sur /app
                    sh "docker run --rm -v \"jenkins_home:/var/jenkins_home\" node:22-alpine sh -c 'cp -r \"/var/jenkins_home/workspace/${env.JOB_NAME}/server\" /tmp/app && cd /tmp/app && npm install && npm run test:coverage && cp -r coverage \"/var/jenkins_home/workspace/${env.JOB_NAME}/server/\"'"
                }
            }
        }

        stage('🔍 SonarQube Analysis') {
            steps {
                script {
                    echo "Running SonarQube Scan..."
                    // On passe les paramètres en direct et on pointe vers le rapport de couverture
                    sh "docker run --rm -v \"jenkins_home:/var/jenkins_home\" -w \"/var/jenkins_home/workspace/${env.JOB_NAME}\" --network buildmarket-net sonarsource/sonar-scanner-cli -Dsonar.projectKey=buildmarket-backend -Dsonar.projectName=\"BuildMarket Backend\" -Dsonar.sources=server/src -Dsonar.host.url=http://buildmarket-sonar:9000 -Dsonar.token=\$SONAR_AUTH -Dsonar.javascript.lcov.reportPaths=server/coverage/lcov.info"
                }
            }
        }

        stage('📦 Build Backend') {
            steps {
                script {
                    echo "🔨 Building Backend Image (Node.js 22)..."
                    sh "docker build -t ${DOCKER_HUB_USER}/buildmarket-backend:latest ./server"
                }
            }
        }

        stage('🤖 Build Geometry') {
            steps {
                script {
                    echo "🐍 Building Geometry IA Image (Python)..."
                    sh "docker build -t ${DOCKER_HUB_USER}/buildmarket-geometry:latest ./server/geometry"
                }
            }
        }

        stage('☁️ Push Images') {
            steps {
                script {
                    echo "🔐 Logging into DockerHub..."
                    sh "echo \$DOCKER_CREDS_PSW | docker login -u \$DOCKER_CREDS_USR --password-stdin"
                    
                    echo "📤 Pushing Backend..."
                    sh "docker push ${DOCKER_HUB_USER}/buildmarket-backend:latest"
                    
                    echo "📤 Pushing Geometry..."
                    sh "docker push ${DOCKER_HUB_USER}/buildmarket-geometry:latest"
                }
            }
            post {
                always {
                    sh "docker logout"
                }
            }
        }

        stage('🔗 Trigger Frontend') {
            steps {
                script {
                    echo "➡️ Triggering Frontend Pipeline: buildmarket-frontend"
                    // Trigger the second job. Ensure the job name matches exactly in Jenkins.
                    build job: 'buildmarket-frontend', wait: false, propagate: false
                }
            }
        }
    }

    post {
        success {
            echo "✅ Backend & Geometry Pipeline finished successfully!"
        }
        failure {
            echo "❌ Pipeline failed. Check logs for details."
        }
    }
}
