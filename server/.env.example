PORT=5000

MONGO_URI=mongodb+srv://USER:PASSWORD@cluster.mongodb.net/artisanet?retryWrites=true&w=majority

# MONGO_DNS_SERVERS=8.8.8.8,8.8.4.4

MONGO_URI_FALLBACK=mongodb://127.0.0.1:27017/artisanet

NODE_ENV=development

JWT_SECRET=change_me_in_production
JWT_EXPIRE=7d
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
# URL exacte du front (navigateur). Doit correspondre à l’URL ouverte (ex. http://192.168.1.10:5176 si accès LAN).
CLIENT_URL=http://localhost:5176

# Origines supplémentaires CORS, séparées par des virgules (ex. http://192.168.1.10:5176,http://localhost:5173)
CORS_EXTRA_ORIGINS=
SMTP_EMAIL=
SMTP_PASSWORD=
GEMINI_API_KEY=
OPENAI_API_KEY=
GROQ_API_KEY=
AI_PROVIDER=groq
GROQ_MODEL=llama-3.3-70b-versatile

# --- Texte → plan 2D (SVG) + service géométrie optionnel ---
# Lancez le service Python (voir README) puis :
GEOMETRY_SERVICE_URL=http://127.0.0.1:8008
# TEXT2D_PLAN_MAX_INPUT_LENGTH=6000
# TEXT2D_PLAN_CACHE_TTL_MS=300000
# TEXT2D_PLAN_CACHE_MAX=200
# TEXT2D_ARCH_GUIDE_MAX_CHARS=
# TEXT2D_SKIP_INPUT_GUARD=1

# --- Rendu image /plan-2d/render (OpenAI images ou HF, optionnel) ---
# TEXT2D_RENDER_OPENAI_MODEL=gpt-image-1
# TEXT2D_RENDER_OPENAI_SIZE=1024x1024
# TEXT2D_RENDER_CACHE_TTL_MS=900000
# TEXT2D_RENDER_CACHE_MAX=100
# TEXT2D_RENDER_HF_MODEL=stabilityai/sdxl-turbo
# TEXT2D_RENDER_HF_PROVIDER=auto
# TEXT2D_RENDER_HF_STEPS=20
# TEXT2D_RENDER_HF_GUIDANCE=7.5
# HUGGINGFACE_TOKEN=

# --- Rendu photo gratuit (local) via ComfyUI ---
# 1) Installer ComfyUI, le lancer (par défaut: http://127.0.0.1:8188)
# 2) Dans ComfyUI: Workflow → Save (API format) → sauvegarder un JSON
# 3) Dans ce JSON, mettez des placeholders dans les nodes texte:
#    - positive prompt: {{PROMPT}}
#    - negative prompt: {{NEGATIVE_PROMPT}}
# 4) Configurez ci-dessous:
# COMFYUI_URL=http://127.0.0.1:8188
# COMFYUI_WORKFLOW_PATH=C:\\path\\to\\comfyui_workflow_api.json
# COMFYUI_TIMEOUT_MS=140000
# COMFYUI_POLL_MS=800

# URL publique du serveur (utile pour URLs absolues si besoin)
SERVER_PUBLIC_URL=http://localhost:5000
